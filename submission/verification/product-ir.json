{
  "product": {
    "name": "Home Library",
    "description": "A simple personal home library tracker. Add each book with title, author, and type; note who has borrowed one and clear it when it comes back; see all books in one list and filter to just those currently lent out.",
    "genome": "tracker",
    "targetUser": "One person keeping track of their own books at home",
    "tagline": "",
    "accent": "#5b5bd6",
    "design": {
      "tone": "warm",
      "density": "comfortable",
      "contrast": "balanced",
      "motion": "subtle"
    }
  },
  "entities": [
    {
      "name": "book",
      "plural": "books",
      "primaryField": "title",
      "fields": [
        {
          "id": "title",
          "label": "Title",
          "type": "text",
          "required": true,
          "placeholder": "e.g. The Hitchhiker's Guide to the Galaxy"
        },
        {
          "id": "author",
          "label": "Author",
          "type": "text",
          "required": false,
          "placeholder": "e.g. Douglas Adams"
        },
        {
          "id": "type",
          "label": "Type",
          "type": "category",
          "required": false,
          "placeholder": "Novel, Cookbook, Reference...",
          "options": [
            "Novel",
            "Cookbook",
            "Reference",
            "Biography",
            "Poetry",
            "Children's",
            "Non-fiction"
          ],
          "allowCustom": true
        },
        {
          "id": "borrower",
          "label": "Borrowed by",
          "type": "text",
          "required": false,
          "placeholder": "Who has it right now?"
        },
        {
          "id": "lent_on",
          "label": "Lent on",
          "type": "date",
          "required": false
        },
        {
          "id": "status",
          "label": "Status",
          "type": "status",
          "required": false,
          "options": [
            "On shelf",
            "Lent out"
          ],
          "derive": {
            "kind": "presence",
            "sourceField": "borrower",
            "whenPresent": "Lent out",
            "whenEmpty": "On shelf"
          }
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "lent_out",
      "label": "Lent out",
      "field": "status",
      "operator": "equals",
      "value": "Lent out"
    },
    {
      "id": "on_shelf",
      "label": "On shelf",
      "field": "status",
      "operator": "equals",
      "value": "On shelf"
    }
  ],
  "charts": [
    {
      "id": "books_by_type",
      "label": "Books by type",
      "type": "pie",
      "xField": "type"
    }
  ],
  "quickActions": [
    {
      "id": "returned",
      "label": "Returned",
      "field": "borrower",
      "set": "clear"
    }
  ],
  "assumptions": [
    "Single local user, no login",
    "Borrower is a free-text name, not a separate contacts list",
    "Lent-on date is optional extra detail; presence of a borrower name is what marks a book lent out",
    "Lent out status auto-derives from the borrower field so it can never drift from the truth"
  ],
  "version": "1",
  "capabilities": {
    "create": true,
    "edit": true,
    "delete": true,
    "search": true,
    "filter": true,
    "sort": true,
    "group": true,
    "transition": false,
    "calculate": true,
    "export": false
  },
  "calculations": [
    {
      "id": "status_on_shelf_count",
      "label": "On shelf",
      "operation": "countWhere",
      "field": "status",
      "operator": "equals",
      "value": "On shelf"
    },
    {
      "id": "status_lent_out_count",
      "label": "Lent out",
      "operation": "countWhere",
      "field": "status",
      "operator": "equals",
      "value": "Lent out"
    }
  ],
  "persistence": {
    "strategy": "localStorage"
  },
  "excluded": [],
  "customRequirements": []
}
