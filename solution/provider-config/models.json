{
  "providers": {
    "berget": {
      "baseUrl": "https://api.berget.ai/v1",
      "api": "openai-completions",
      "apiKey": "$BERGET_API_KEY",
      "authHeader": true,
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": true,
        "maxTokensField": "max_tokens",
        "thinkingFormat": "baseten",
        "chatTemplateArgs": {
          "enable_thinking": {
            "$var": "thinking.enabled"
          }
        }
      },
      "models": [
        {
          "id": "zai-org/GLM-5.2",
          "name": "GLM-5.2 via Berget",
          "reasoning": true,
          "thinkingLevelMap": {
            "off": "none",
            "minimal": null,
            "low": null,
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": "max"
          },
          "input": ["text"],
          "contextWindow": 128000,
          "maxTokens": 16384,
          "cost": {
            "input": 0,
            "output": 0,
            "cacheRead": 0,
            "cacheWrite": 0
          }
        }
      ]
    }
  }
}
