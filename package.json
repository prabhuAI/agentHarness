{
  "name": "agent-cofounder-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "challenge": "node --import tsx src/run-challenge.ts",
    "dev": "npm --prefix output/app run dev",
    "validate:result": "node --import tsx src/validate-result.ts",
    "report": "node --import tsx src/render-run.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:golden": "vitest run test/golden.test.ts",
    "test:golden:record": "UPDATE_GOLDEN=1 vitest run test/golden.test.ts",
    "app:test": "npm --prefix app-template test -- --passWithNoTests",
    "app:build": "npm --prefix app-template run build",
    "benchmark": "node --import tsx benchmarks/run-benchmark.ts",
    "submission:freeze": "node scripts/freeze-submission.mjs",
    "check": "npm run typecheck && npm run test && npm run app:test && npm run app:build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "ajv": "8.20.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}
